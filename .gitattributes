# Git LFS: только по-настоящему бинарные/крупные файлы.
# Текстовые YAML-ассеты Unity (*.asset, *.prefab, *.unity, *.anim,
# *.controller, *.physicMaterial, *.meta) оставляем обычным текстом —
# у них остаются diffs и корректное разрешение конфликтов.

# Изображения
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
